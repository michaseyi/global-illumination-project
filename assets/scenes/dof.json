{
  // depth-of-field demo: thin-lens camera focused on the green sphere; the red
  // foreground and the far spheres/forest defocus. set "aperture" to 0 for a
  // pinhole comparison.
  "environment": { "file": "../env/forest_2k.hdr", "scale": 1.0, "rotation": 270 },
  "camera": { "eye": [-0.5, 1.0, 4.5], "target": [0, 0.5, 0], "up": [0,1,0],
              "fov": 40, "aperture": 0.30, "focus": 4.55 },
  "materials": {
    "floor": { "type": "lambert", "texture": "../textures/checker.png" },
    "red":   { "type": "lambert",   "color": [0.75, 0.15, 0.12] },
    "green": { "type": "lambert",   "color": [0.15, 0.6, 0.2] },
    "blue":  { "type": "lambert",   "color": [0.15, 0.25, 0.7] },
    "gold":  { "type": "conductor", "color": [1.0, 0.78, 0.34], "roughness": 0.15 },
    "chrome":{ "type": "mirror",    "color": [0.9, 0.9, 0.9] }
  },
  "objects": [
    { "type": "quad", "material": "floor", "origin": [-8,0,8], "u": [16,0,0], "v": [0,0,-16] },
    { "type": "sphere", "material": "red",    "center": [-1.3, 0.5,  2.0], "radius": 0.5 },
    { "type": "sphere", "material": "green",  "center": [ 0.0, 0.5,  0.0], "radius": 0.5 },
    { "type": "sphere", "material": "blue",   "center": [ 1.3, 0.5, -2.0], "radius": 0.5 },
    { "type": "sphere", "material": "gold",   "center": [ 2.6, 0.5, -4.0], "radius": 0.5 },
    { "type": "sphere", "material": "chrome", "center": [ 3.9, 0.5, -6.0], "radius": 0.5 }
  ],
  "lights": []
}
